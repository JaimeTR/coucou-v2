{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coucou",
  "version": "1.0.0",
  "identifier": "fr.louisraille.coucou",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    },
    "windows": [
      {
        "label": "island",
        "title": "Coucou",
        "url": "index.html",
        "width": 240,
        "height": 6,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "center": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": { "../target/release/coucou-hook.exe": "coucou-hook.exe" },
    "copyright": "© JaimeTR · based on Coucou by Louis Raillé",
    "category": "DeveloperTool",
    "shortDescription": "Mochi vive en la parte superior de tu pantalla",
    "longDescription": "Coucou pone a Mochi en la parte superior de tu pantalla: muestra tus sesiones de Claude Code y varias integraciones, y te deja aprobar, responder, chatear y soltar archivos sin dejar lo que estás haciendo.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "installerHooks": "nsis/hooks.nsh"
      },
      "wix": {
        "language": "es-ES"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyMUMyMzM2Mzk0RUIzODEKUldTQnMwNDVOaU1jZ2lobmJUWTROYTN2elUwa1NqbFVhWUlhTUJoOGFyZmtDMlFhUm82d1l1S1QK",
      "endpoints": [
        "https://github.com/JaimeTR/coucou-v2/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
