{
  "expo": {
    "name": "Coucou",
    "slug": "coucou-mobile",
    "scheme": "coucou",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jaimetr.coucou"
    },
    "android": {
      "package": "com.jaimetr.coucou",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0C0E"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#0B0C0E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Coucou usa la cámara solo para leer el QR que enlaza tu PC."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Coucou usa Face ID para confirmar que eres tú antes de permitir un comando en tu PC."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0C0E"
        }
      ]
    ],
    "extra": {
      "author": "JaimeTR",
      "router": {},
      "eas": {
        "projectId": "51d7908f-5a0d-4f19-baab-085bc56f5565"
      }
    },
    "owner": "jaimetrdev"
  }
}
